{"version":3,"kind":"Article","sha256":"3380327c98864a16c4c8130a17755ffa2fdc58e1fa9e8c51b8b06956fae196de","slug":"index","location":"/coursMQ1.md","dependencies":[],"frontmatter":{"title":"INTRODUCTION A LA MECANIQUE QUANTIQUE","exports":[{"format":"md","filename":"coursMQ1.md","url":"https://ngAtUbo.github.io/MQ_test_interactif/build/coursMQ1-d9b2ab6e23ee4cb1d18225664d56f734.md"}],"content_includes_title":false,"authors":[{"nameParsed":{"literal":"Gilles Nguyen Vien","given":"Gilles Nguyen","family":"Vien"},"name":"Gilles Nguyen Vien","affiliations":["Département de Physique, Université de Bretagne Occidentale"],"id":"contributors-myst-generated-uid-0"}],"license":{"content":{"id":"CC-BY-NC-ND-4.0","url":"https://creativecommons.org/licenses/by-nc-nd/4.0/","name":"Creative Commons Attribution Non Commercial No Derivatives 4.0 International","CC":true}},"affiliations":[{"id":"Département de Physique, Université de Bretagne Occidentale","name":"Département de Physique, Université de Bretagne Occidentale"}],"thumbnail":"https://ngAtUbo.github.io/MQ_test_interactif/build/image1-ae1d69dd9a895c8f114e430c9d14f560.png"},"mdast":{"type":"root","children":[{"type":"block","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"children":[{"type":"text","value":"Lecture notes in French on the introduction to quantum physics and Dirac formalism. Some of the experiments that led to the development of a new physical theory, quantum physics, are presented. The foundations of quantum mechanics are introduced, showing that they responded to questions raised by experiments in the late nineteenth and early twentieth centuries, the interpretation of which defied the certainties established by classical physics.","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"key":"Kwsg9AB7Ft"}],"key":"P6pQhlRnEW"}],"data":{"part":"abstract"},"key":"n7WVO8Q